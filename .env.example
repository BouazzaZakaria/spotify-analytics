# Set true to load pipeline tables into PostgreSQL; false writes CSVs to output/.
USE_POSTGRES=false
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/spotify_analytics

# Required only when using Spotify API extraction helpers in extract.py.
SPOTIPY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIPY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET